MYSQL_DATABASE=smart_bi
MYSQL_USER=smart_bi
MYSQL_PASSWORD=smart_bi_local_password
MYSQL_ROOT_PASSWORD=smart_bi_local_root_password
DATABASE_URL=mysql+pymysql://smart_bi:smart_bi_local_password@mysql:3306/smart_bi
# Generate a unique valid Fernet key before starting; Task 8 start.ps1 will automate this.
APP_ENCRYPTION_KEY=GENERATE_BEFORE_START
FRONTEND_ORIGIN=http://localhost:8080
# Set true only when the optional PyTorch CPU forecasting engine is required.
INSTALL_TORCH=false
FORECAST_ENGINE=ols
